# Local service
COMPANION_PORT=8765
MOCK_CHAT=true

# Twitch: user token must include user:read:chat
TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=
TWITCH_BROADCASTER_ID=
TWITCH_USER_ID=

# YouTube OAuth access token. LIVE_CHAT_ID is optional; when blank, the
# companion discovers the authenticated channel's active broadcast.
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_LIVE_CHAT_ID=

# Optional official Kick relay connection
KICK_RELAY_URL=wss://your-relay.example.com/stream
KICK_RELAY_TOKEN=

